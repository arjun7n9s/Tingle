{
  "name": "@tingle/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "prove:live": "tsx src/scripts/prove-live.ts",
    "prove:heal": "tsx src/scripts/prove-heal.ts",
    "first-look": "tsx src/scripts/first-look.ts",
    "api": "tsx src/http.ts",
    "prove:shell": "tsx src/scripts/prove-shell.ts",
    "prove:loop": "tsx src/scripts/prove-loop.ts",
    "prove:vault": "tsx src/scripts/prove-vault.ts",
    "prove:dedup": "tsx src/scripts/prove-dedup.ts",
    "test": "tsx --test src/claim.test.ts src/piles.test.ts src/bd/validate.test.ts src/firstLook.test.ts src/analyst.test.ts src/tingleTick.test.ts src/vault.test.ts src/dedup.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
