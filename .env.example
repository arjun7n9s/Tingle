# ─────────────────────────────────────────────────────────────
# Bright Data
# ─────────────────────────────────────────────────────────────

# Accepted under either name — the CLI reads BRIGHTDATA_API_KEY, this repo's
# code prefers BRIGHT_DATA_API_TOKEN. Set one. Never commit it.
BRIGHT_DATA_API_TOKEN=
# BRIGHTDATA_API_KEY=

# Optional Web Unlocker zone for public patent/paper detail pages. This is
# deliberately separate from the pinned Scraper Studio collectors below.
# TINGLE_UNLOCKER_ZONE=

# ─────────────────────────────────────────────────────────────
# Pinned Scraper Studio collectors
# ─────────────────────────────────────────────────────────────
# Create once, then paste the ids here and leave them alone. `scraper create`
# takes 5-25 minutes, costs credits, and a fresh id orphans every pointer that
# referenced the old one. See docs/collectors.md.
#
# This workspace's real ids are pinned in AGENTS.md (not secrets). Clones keep
# the placeholders until they have created their own collectors.

TINGLE_C_SEARCH=c_xxxxxxxx
TINGLE_C_WATCH=c_xxxxxxxx
TINGLE_C_CHAOS=c_xxxxxxxx

# ─────────────────────────────────────────────────────────────
# Targets
# ─────────────────────────────────────────────────────────────

# Watch target: a public launch board, changelog, docs index, or niche
# directory with dated entries. Must be long-tail — verify no maintained
# pre-built extractor already covers it before creating a collector.
TINGLE_WATCH_URL=https://www.uneed.best/

# Public chaos fixture (fixtures/tingle-chaos/, served over GitHub Pages).
TINGLE_CHAOS_URL=https://arjun7n9s.github.io/Tingle/fixtures/tingle-chaos/

# Redesigned markup used to trip Zod without swapping GitHub Pages. Optional.
# TINGLE_CHAOS_BROKEN_URL=

# Search lane: a public community listing with dated posts — a tag page, a
# forum index, a "latest" feed. Deliberately NOT a site's own /search endpoint.
TINGLE_SEARCH_URL=https://dev.to/t/indiehackers

# Optional country, if the collector takes a keyword input. Empty = default.
TINGLE_SEARCH_COUNTRY=

# Claim used by prove:tingle-live.
TINGLE_SAMPLE_CLAIM="a watch that tells indie builders when someone else ships their idea"

# ─────────────────────────────────────────────────────────────
# Modes
# ─────────────────────────────────────────────────────────────

# 1 runs the full validate → heal → retry state machine on fixtures.
# No token, no credits. Not evidence of live collector usage.
TINGLE_MOCK=0

# 1 = unattended heal (CI / cron). Default is preview then explicit approve.
# TINGLE_HEAL_AUTO_APPROVE=0

# Product API (auth, first look, Tingle tick). Mock-by-default when no token.
TINGLE_API_PORT=8788

# Browser talks to /tingle-api on the Next server (same origin).
# NEXT_PUBLIC_TINGLE_API_URL=http://127.0.0.1:8788
# Vercel: Next rewrites /tingle-api/* here. Include https://.
# TINGLE_API_PROXY=https://api.tejs.dev
TINGLE_PUBLIC_URL=http://localhost:3000/tingle-api
TINGLE_APP_URL=http://localhost:3000/tingle

# In-process Tingle worker. 0 disables the interval; POST /projects/:id/tick still works.
# TINGLE_TICK_MS=900000
# TINGLE_CRON_SECRET=
# TINGLE_BUDGET_CAP=50

# Envelope master (32 bytes as 64 hex chars). If unset, .data/tingle/vault.key is created.
# TINGLE_VAULT_MASTER=
# TINGLE_DATA_DIR=

# Optional Bright Data SERP zone (adjunct URL discovery). Never a fourth Studio collector.
# TINGLE_SERP_ZONE=
# TINGLE_PREMIUM_API_TOKEN=
# TINGLE_UNLOCKER_TOKEN=
# TINGLE_PREMIUM_UNLOCKER_ZONE=

# Optional alert hooks. Empty = skip.
# TINGLE_WEBHOOK_URL=
# TINGLE_SLACK_WEBHOOK_URL=
# TINGLE_DISCORD_WEBHOOK_URL=

# Optional AIMLAPI / OpenAI-compatible extractor normalizer. Missing key = skip.
# AIMLAPI_KEY=
# TINGLE_LLM_MODEL=gpt-4o
