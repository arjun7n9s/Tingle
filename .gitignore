.cursor/rules/

node_modules/
dist/
.next/
.data/
.env
.env.local
*.log
*.tsbuildinfo
.DS_Store
docs/proof/tingle/live/

# Mock proof runs are throwaway — regenerate them any time with
# `npm run prove:tingle-live` / `prove:tingle-heal`.
docs/proof/**/*-mock-*.json

# Collect runs record the URLs and titles of whatever they scraped. You cannot
# evidence a live scrape without other people's content, so these stay local.
# The chaos heal proof is committed instead: the fixture it scrapes is ours,
# and the heal round trip is the claim that actually needs proving.
docs/proof/live/

# Raw `scraper create` envelopes — collector ids get pinned into .env instead
.creates/

# Working strategy docs — named third parties, comps, trademark notes.
# Kept in the working folder for reference, never published.
docs/internal/

# Progress log — names the scrape targets, which the published tree does not.
progress.md

# Local first-look request fixtures
.fixtures/
